    {
      "type": "wokwi-text",
      "id": "title",
      "left": -1000,
      "top": -600,
      "attrs": {
        "text": "ECU / 4 valcu, ctyrtakt - signalove schema"
      }
    },
    {
      "type": "wokwi-text",
      "id": "power_note",
      "left": -1000,
      "top": -550,
      "attrs": {
        "text": "V aute: baterie 12 V -> pojistka -> hlavni rele -> zateze / regulator ECU\nZde: cervena sit = logicke napajeni MCU; POWER_EN = model napajeni zatezi, nikoli 12 V."
      }
    },
    {
      "type": "wokwi-text",
      "id": "motor_label",
      "left": -1100,
      "top": -120,
      "attrs": {
        "text": "MOTOR / MODEL\nCKP 60-2, CMP, MAP, TPS, IAT, CLT, lambda\nUART do Pythonu patri simulatoru, ne ECU"
      }
    },
    {
      "type": "wokwi-text",
      "id": "inputs_label",
      "left": -500,
      "top": -100,
      "attrs": {
        "text": "KABELAZ / VSTUPY ECU\nCKP/CMP uz po tvarovani\nanalogove signaly uz v rozsahu ADC"
      }
    },
    {
      "type": "wokwi-text",
      "id": "ecu_label",
      "left": 0,
      "top": -100,
      "attrs": {
        "text": "ECU - mikroprocesor\nCKP/CMP -> casovani -> INJ/IGN\nUART TX = pouze diagnostika"
      }
    },
    {
      "type": "wokwi-text",
      "id": "driver_label",
      "left": 550,
      "top": -100,
      "attrs": {
        "text": "VYKONOVE VYSTUPY\nINJ: low-side MOSFET + ochrana\nIGN: IGBT / chytra civka + omezeni napeti\nZde logicky model driveru a zateze"
      }
    },
    {
      "type": "wokwi-text",
      "id": "switch_label",
      "left": 670,
      "top": -180,
      "attrs": {
        "text": "HLAVNI RELE: vlevo ON / vpravo OFF\nOdpoji zateze, ECU a snimace bezi dal"
      }
    },
    {
      "type": "wokwi-text",
      "id": "loads_label",
      "left": 1150,
      "top": -100,
      "attrs": {
        "text": "INDIKACE ZATEZI\nzelena = vstrik otevren\nzluta = civka se nabiji; zhasnuti = konec nabijeni"
      }
    },
